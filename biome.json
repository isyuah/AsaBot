{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "plugins/**/*.ts",
      "test/**/*.ts",
      "web/vite.config.ts",
      "web/src/**/*.tsx",
      "web/src/**/*.ts",
      "package.json",
      "tsconfig.json",
      "tsconfig.build.json",
      "biome.json",
      "vitest.config.ts",
      "asabot.config.example.yaml",
      "!dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
