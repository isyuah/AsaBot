{
  "name": "@asabot/core",
  "version": "0.1.0",
  "description": "协议无关的 TypeScript 聊天机器人框架，内置 Web 面板、任务中心及 OneBot 11、飞书、企业微信、微信 ClawBot 适配器",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./feishu": "./src/adapters/feishu/index.ts",
    "./onebot11": "./src/adapters/onebot11/index.ts",
    "./onebot11/testing": "./src/adapters/onebot11/testing.ts",
    "./wecom": "./src/adapters/wecom/index.ts",
    "./weixin-clawbot": "./src/adapters/weixin-clawbot/index.ts"
  },
  "bin": {
    "asabot": "./src/cli.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./feishu": {
        "types": "./dist/adapters/feishu/index.d.ts",
        "default": "./dist/adapters/feishu/index.js"
      },
      "./onebot11": {
        "types": "./dist/adapters/onebot11/index.d.ts",
        "default": "./dist/adapters/onebot11/index.js"
      },
      "./onebot11/testing": {
        "types": "./dist/adapters/onebot11/testing.d.ts",
        "default": "./dist/adapters/onebot11/testing.js"
      },
      "./wecom": {
        "types": "./dist/adapters/wecom/index.d.ts",
        "default": "./dist/adapters/wecom/index.js"
      },
      "./weixin-clawbot": {
        "types": "./dist/adapters/weixin-clawbot/index.d.ts",
        "default": "./dist/adapters/weixin-clawbot/index.js"
      }
    },
    "bin": {
      "asabot": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "docs/FEISHU.md",
    "docs/WECOM.md",
    "docs/WEIXIN-CLAWBOT.md",
    "LICENSE",
    "asabot.config.example.yaml"
  ],
  "scripts": {
    "dev": "node src/cli.ts dev",
    "start": "node src/cli.ts start",
    "build": "pnpm --filter @asabot/panel-ui build && pnpm --filter web build && pnpm build:lib",
    "build:lib": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --configLoader native"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "croner": "^11.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "semver": "^7.8.6",
    "silk-wasm": "^3.7.1",
    "undici": "^8.12.4",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
